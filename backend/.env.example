# ============================================
# Peekaboo Shades - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server Configuration
NODE_ENV=development
PORT=3001

# Security
JWT_SECRET=your-secure-256-bit-secret-key-here

# Stripe Payment Gateway
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# PayPal Payment Gateway
# Get keys from: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Email Service (SendGrid)
# Get key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=orders@peekabooshades.com
EMAIL_FROM_NAME=Peekaboo Shades

# Google Analytics
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Facebook Pixel
FACEBOOK_PIXEL_ID=xxxxxxxxxxxx

# SMS Service (Twilio)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Cloud Storage (AWS S3 or similar)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=peekabooshades-media
AWS_REGION=us-east-1

# Slack Notifications (for admin alerts)
# Get webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Custom Webhook URL for alerts (Zapier, Make, etc.)
CUSTOM_WEBHOOK_URL=

# Low Stock Alert Threshold (products below this trigger alerts)
LOW_STOCK_THRESHOLD=10

# Anthropic AI (for AI features)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Error Monitoring (Sentry)
# Get DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=https://xxxxx@xxx.ingest.sentry.io/xxxxxx
